# cp docker/.env.example docker/.env, then set real values
JWT_SECRET=change-me-to-a-long-random-string
BOOTSTRAP_TOKEN=change-me-one-time-tenant-creation-token
# base64 of 32 random bytes: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# LAN IP or domain other devices use to reach this server (apps are rebuilt with it)
PUBLIC_HOST=localhost
